# LDO regulator + decoupling cap — should import cleanly.

Component(
    "U1",
    mpn = "MCP1700T-3302E/TT",
    value = "3.3V LDO",
    package = "SOT-23",
    pins = [
        ("1", "GND", "ground"),
        ("2", "VOUT", "power"),
        ("3", "VIN", "power"),
    ],
)

Component(
    "C1",
    value = "1uF",
    package = "0402",
    pins = [
        ("1", "1", "passive"),
        ("2", "2", "ground"),
    ],
)

Net("VIN", ["U1.3"])
Net("VOUT", ["U1.2", "C1.1"])
Net("GND", ["U1.1", "C1.2"])
