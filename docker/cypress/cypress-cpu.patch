+    T ofx = pin_offset_x[i] - wi / 2, ofy = pin_offset_y[i] - hi / 2;
+    pin_x[i] = (xi + wi / 2) + ofx * c - ofy * s;
+    pin_y[i] = (yi + hi / 2) + ofx * s + ofy * c;
+  }
+  return 0;
+}
 
