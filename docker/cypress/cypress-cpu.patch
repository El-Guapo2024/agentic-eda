+#pragma omp parallel for num_threads(num_threads)
+  for (int i = 0; i < num_pins; ++i) {
+    int node_id = pin2node_map[i];
+    T xi = x[node_id], yi = y[node_id];
+    T hi = h[node_id], wi = w[node_id];
